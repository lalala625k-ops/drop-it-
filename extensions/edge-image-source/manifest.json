{
  "manifest_version": 3,
  "name": "图片带出处 · Edge",
  "version": "1.0.0",
  "description": "右键复制图片，同时携带可点击的原网页链接；也可保存为带出处的离线图片页面。",
  "minimum_chrome_version": "109",
  "permissions": ["contextMenus", "scripting", "offscreen", "clipboardWrite", "storage", "downloads"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": {
    "default_title": "图片带出处：在网页图片上右键开始",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
